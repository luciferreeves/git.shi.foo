<div class="repo-header">
  <div class="repo-identity">
    <a class="repo-name" href="/{{ Owner }}/{{ Name }}">{{ Owner }}/{{ Name }}</a>
    <span class="repo-visibility">{% if Private %}private{% else %}public{% endif %}</span>
  </div>
  {% if Description %}<p class="repo-description">{{ Description }}</p>{% endif %}
  <div class="repo-meta">
    <span>default branch <b class="text-green">{{ DefaultBranch }}</b></span>
    <span class="repo-meta-separator">·</span>
    <span>status <b>{{ Status }}</b></span>
  </div>
  <div class="repo-clone">
    <input type="radio" name="clone-protocol" id="clone-https" class="clone-radio" checked>
    <input type="radio" name="clone-protocol" id="clone-ssh" class="clone-radio">
    <div class="clone-tabs">
      <label class="clone-tab" for="clone-https">HTTPS</label>
      <label class="clone-tab" for="clone-ssh">SSH</label>
    </div>
    <div class="clone-field" data-protocol="https">
      <input class="clone-url" type="text" value="{{ CloneURL }}" readonly spellcheck="false">
      <button class="clone-copy" type="button">copy</button>
    </div>
    <div class="clone-field" data-protocol="ssh">
      <input class="clone-url" type="text" value="{{ SSHCloneURL }}" readonly spellcheck="false">
      <button class="clone-copy" type="button">copy</button>
    </div>
  </div>
</div>
<script src="{% static "js/clone.js" %}" defer></script>

<nav class="repo-tabs">
  <a class="repo-tab{% if ActiveTab == "files" %} is-active{% endif %}" href="/{{ Owner }}/{{ Name }}">files</a>
  <a class="repo-tab{% if ActiveTab == "commits" %} is-active{% endif %}" href="/{{ Owner }}/{{ Name }}/commits">commits</a>
  <a class="repo-tab{% if ActiveTab == "branches" %} is-active{% endif %}" href="/{{ Owner }}/{{ Name }}/branches">branches</a>
  <a class="repo-tab{% if ActiveTab == "tags" %} is-active{% endif %}" href="/{{ Owner }}/{{ Name }}/tags">tags</a>
  <a class="repo-tab{% if ActiveTab == "contributors" %} is-active{% endif %}" href="/{{ Owner }}/{{ Name }}/contributors">contributors</a>
  <a class="repo-tab is-disabled">settings</a>
</nav>
